    <!-- HomeScreen Didactic Explanations -->
    <string name="home_welcome_title">Willkommen zur On-Device AI Lerneinheit</string>
    <string name="home_welcome_desc">Diese App demonstriert die Echtzeit-Verarbeitung von Kameraframes mit Google MediaPipe HandLandmarker und die Übersetzung in 3D-Geometrie in Jetpack Compose.</string>

    <string name="gesture_pinch_title">1. Greifen &amp; Verschieben (Pinch)</string>
    <string name="gesture_pinch_desc">Führe Daumen- und Zeigefingerspitze zusammen. Der 3D-Würfel wird erfasst (leuchtet grün) und folgt deiner Fingerbewegung flüssig über den Bildschirm.</string>

    <string name="gesture_fist_title">2. Drehen an der Stelle (Faust)</string>
    <string name="gesture_fist_desc">Schließe deine Hand zu einer Faust. Neige die Faust nach oben/unten oder links/rechts, um den 3D-Drahtgitter-Würfel räumlich zu rotieren.</string>

    <string name="gesture_open_title">3. Ruhezustand (Offene Hand)</string>
    <string name="gesture_open_desc">Halte deine Hand flach und offen vor die Kamera. Die App zeichnet das 21-Gelenke-Skelett, führt aber keine ungewollte Bewegung aus.</string>

    <string name="btn_start_cube">Jetzt KI-Würfel ausprobieren ➔</string>

    <!-- Camera Permission -->
    <string name="permission_title">Kamerazugriff erforderlich</string>
    <string name="permission_description">Für die On-Device AI Gestensteuerung mit MediaPipe wird der Zugriff auf die Frontkamera benötigt. Die Videoverarbeitung erfolgt zu 100% lokal auf deinem Gerät.</string>
    <string name="permission_button">Kamera freigeben</string>
